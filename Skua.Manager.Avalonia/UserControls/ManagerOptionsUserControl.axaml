<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.Manager.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.ManagerOptionsUserControl"
             d:DataContext="{d:DesignInstance vms:ManagerOptionsViewModel}"
             d:DesignWidth="800"
             d:DesignHeight="500"
             mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        
        <!-- Header Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <StackPanel Spacing="2">
                <TextBlock Text="PREFERENCES &amp; WORKSPACE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaTextBrush}"
                           Text="Manager Configuration" />
                <TextBlock Text="Configure launch behavior, theme synchronization, and download paths."
                           FontSize="12"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Download Path Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="CLIENT DOWNLOAD LOCATION"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            Padding="12,8"
                            ToolTip.Tip="Target destination folder for downloaded updates and clients.">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DownloadPath, FallbackValue='Client Download Folder'}"
                                   FontFamily="JetBrains Mono,Consolas,Courier New,monospace"
                                   FontSize="12"
                                   Foreground="{DynamicResource SkuaTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1"
                            Height="36"
                            Command="{Binding ChangeDownloadPathCommand}"
                            Classes="skua-button">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="14" Height="14" />
                            <TextBlock Text="Change Path" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Options Toggles Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="APPLICATION BEHAVIOR"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ManagerOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,6"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Content}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding Value, Mode=TwoWay}"
                                                      OnContent=""
                                                      OffContent=""
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
