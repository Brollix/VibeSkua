<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sharedControls="clr-namespace:Skua.Shared.Avalonia.Controls.Buttons;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.LauncherProcessRow"
             x:Name="Root">
    <Border Margin="0,2"
            Padding="8,4"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountName}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProcessId, StringFormat=PID: {0}}"
                           FontSize="11"
                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="8,0,0,0"
                    Command="{Binding StopCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="Kill Process">
                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
