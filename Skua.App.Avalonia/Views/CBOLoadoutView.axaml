<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CBOLoadoutViewModel"
             x:Class="Skua.App.Avalonia.Views.CBOLoadoutView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10" Margin="2">
      <!-- Class Selection Section -->
      <ContentControl Content="{Binding ClassSelectViewModel}" />

      <!-- Equipment Customization Expander -->
      <Expander IsExpanded="False"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="ShieldCrownOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Detailed Equipment Slots"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="{DynamicResource SkuaTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="(Optional per-mode gear overrides)"
                       FontSize="11"
                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <Border Padding="10,8,10,10">
          <ContentControl Content="{Binding ClassEquipmentViewModel}" />
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
