<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             xmlns:sharedOptions="clr-namespace:Skua.Shared.Avalonia.Controls.Options;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOptionsView"
             x:DataType="vms:CBOptionsViewModel">
  <Grid Margin="0" RowDefinitions="Auto,*" RowSpacing="10">
    
    <!-- 1. Search Bar Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <Grid>
        <TextBox Height="32"
                 CornerRadius="6"
                 VerticalContentAlignment="Center"
                 Padding="32,0,10,0"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 Watermark="Filter CoreBots settings, delays, and parameters..." />

        <materialIcons:MaterialIcon Kind="Magnify"
                                    Width="15" Height="15"
                                    Foreground="{DynamicResource SkuaMutedTextBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"
                                    IsHitTestVisible="False" />
      </Grid>
    </Border>

    <!-- 2. Options List Container -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,2"
                      Padding="8,6"
                      Background="{DynamicResource SkuaSurfaceAltBrush}"
                      BorderBrush="{DynamicResource SkuaBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6">
                <sharedOptions:OptionItemControl />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

  </Grid>
</UserControl>
