<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="ButlerV5.SettingsWindow"
        Classes="skua"
        Title="Butler V5 - Settings"
        Width="880" Height="620"
        CanResize="False"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="Manual">

    <Border BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource SkuaSurfaceBrush}">
        <Grid RowDefinitions="Auto,*">
            <shell:WindowTitleBar Grid.Row="0" TitleText="Butler V5 - Settings" />

            <Grid Grid.Row="1" Margin="12" ColumnDefinitions="360,Auto,*">
                <!-- LEFT COLUMN: Settings list (top 2/3) + Description box (bottom 1/3) -->
                <Grid Grid.Column="0" RowDefinitions="2*,*">
                    <!-- Settings scroll container -->
                    <Border Grid.Row="0"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SettingsStack" Margin="0,0,8,0" />
                        </ScrollViewer>
                    </Border>

                    <!-- Selected Setting Description Panel -->
                    <Border Grid.Row="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,6,0,0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="DescTitle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SkuaTextBrush}"
                                           Text="Click a setting" />
                                <TextBlock x:Name="DescBody" FontSize="12" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                           Text="Its description shows here. Changes save instantly and every other logged-in butler picks them up within a couple of seconds." />
                                <TextBlock x:Name="MetaText" FontSize="11" Margin="0,16,0,0"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- RIGHT COLUMN: Logs viewer -->
                <Grid Grid.Column="2" Margin="6,0,0,0" RowDefinitions="Auto,*,Auto">
                    <!-- Log header -->
                    <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="LogTitle" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SkuaTextBrush}"
                                   Text="Logs" />
                        <CheckBox x:Name="FollowTailCheck" Grid.Column="1" Content="Follow tail"
                                  IsChecked="True" VerticalAlignment="Center"
                                  Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </Grid>

                    <!-- Log ListBox: wrapped lines, vertical layout only -->
                    <Border Grid.Row="1"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            Padding="4,4">
                        <ListBox x:Name="LogList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding LevelBrush}"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,8,0" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Log action buttons -->
                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Classes="skua-button" Content="Copy" FontSize="12" Padding="10,3"
                                    ToolTip.Tip="Copy all log lines to the clipboard."
                                    Click="CopyButton_Click" />
                            <Button Classes="skua-button" Content="Save" FontSize="12" Padding="10,3"
                                    ToolTip.Tip="Write the current log to a timestamped file in the butlerv5_logs folder."
                                    Click="SaveButton_Click" />
                            <Button Classes="skua-button" Content="Clear" FontSize="12" Padding="10,3"
                                    ToolTip.Tip="Clear the log view + in-memory buffer (does not delete files on disk)."
                                    Click="ClearButton_Click" />
                        </StackPanel>

                        <Button Grid.Column="1" Classes="skua-button" Content="Open folder" FontSize="12" Padding="10,3"
                                ToolTip.Tip="Open %APPDATA%\VibeSkua\butlerv5_logs in Explorer."
                                Click="OpenFolderButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
