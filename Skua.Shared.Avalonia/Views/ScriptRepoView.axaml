<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scriptRepo="clr-namespace:Skua.Shared.Avalonia.ViewModels.ScriptRepo;assembly=Skua.Shared.Avalonia"
             xmlns:sharedScriptRepo="clr-namespace:Skua.Shared.Avalonia.Controls.ScriptRepo;assembly=Skua.Shared.Avalonia"
             x:DataType="scriptRepo:ScriptRepoViewModel"
             x:Class="Skua.Shared.Avalonia.Views.ScriptRepoView"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="850">
    <sharedScriptRepo:ScriptRepoControl />
</UserControl>
